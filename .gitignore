# Data and tracking (never committed)
/data/
/mlflow-data/
*.parquet
!tests/**/*.parquet

# Reports: only reference hashes and aggregate metrics are committed
/reports/*
!/reports/reference/

# Environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Secrets
.env
.env.*
!.env.example
/.secrets/
/deploy/secrets/

# Application frontend dependencies and generated output
node_modules/
.next/
*.tsbuildinfo
playwright-report/
test-results/

# Notebooks
.ipynb_checkpoints/

# Built feature tables (regenerable)
/features/

# Local companion material and experiment scratch output
/presentation/
/catboost_info/

# Local-only reading and agent material (kept on disk, not published)
/docs/
/AGENTS.md
/apps/web/AGENTS.md
