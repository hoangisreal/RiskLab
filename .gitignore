dist/
build/

# Secrets
.env
.env.*
!.env.example
/.secrets/
/deploy/secrets/

# Application frontend dependencies and generated output
node_modules/
.next/
*.tsbuildinfo
playwright-report/
test-results/

# Notebooks
.ipynb_checkpoints/

# Built feature tables (regenerable)
/features/

# Local companion material and experiment scratch output
/presentation/
/catboost_info/

