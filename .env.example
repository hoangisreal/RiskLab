# Copy to .env and edit. Placeholders only; never commit real secrets.
# Kaggle credentials live in ~/.kaggle/ (managed by the Kaggle CLI) or KAGGLE_* environment variables, not here.
RISKLAB_CONFIG_DIR=configs
MLFLOW_TRACKING_URI=http://localhost:5000
RISKLAB_ADMIN_API_KEY=

# Docker demo only (deploy/compose.demo.yml). Demo-only values with local
# defaults; override to change them, never reuse them outside the demo.
# RISKLAB_DEMO_ADMIN_PASSWORD=
# RISKLAB_DEMO_MANAGER_PASSWORD=
# RISKLAB_DEMO_ANALYST_PASSWORD=
# RISKLAB_DEMO_OWNER_DB_PASSWORD=
# RISKLAB_DEMO_API_DB_PASSWORD=
# RISKLAB_DEMO_WORKER_DB_PASSWORD=

# Business application (host or production). Set exactly one of the URL pair.
# RISKLAB_DATABASE_URL=postgresql+psycopg://user:password@host:5432/risklab
# RISKLAB_DATABASE_URL_FILE=/run/secrets/api_url
# RISKLAB_ENVIRONMENT=development
# RISKLAB_ORIGIN=http://localhost:3000
