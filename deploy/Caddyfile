# RiskLab MVP: only Caddy is public. Replace the site address via {$SITE_ADDRESS}.
{$SITE_ADDRESS:localhost} {
	encode gzip

	# Legacy unauthenticated ML routes must never bypass business auth.
	@legacy path /predict /monitoring/* /admin/models/*
	respond @legacy 404

	@api path /api/*
	reverse_proxy @api api:8000

	reverse_proxy web:3000

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	log {
		output stderr
		format json
	}
}
