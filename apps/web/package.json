{
  "name": "risklab-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' 'tests/**/*.ts' '*.ts' '*.mjs' '*.json'",
    "test:e2e": "playwright test",
    "test:e2e:workflow": "playwright test --config=playwright.workflow.config.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  }
}
